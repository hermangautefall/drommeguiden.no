---
import { alternatesFor } from '../../lib/statiske-alternates';
import Base from '../../layouts/Base.astro';
---

<Base
  lang="en"
  tittel="Cookie policy"
  beskrivelse="An overview of the cookies the Dream Guide uses — analytics, advertising and strictly necessary cookies."
  alternates={alternatesFor('cookies')}
>
  <div class="static-page">
    <span class="static-label">Legal</span>
    <h1 class="static-title">Cookie policy</h1>

    <div class="prose">
      <p class="lead">
        The Dream Guide uses cookies for strictly necessary functionality,
        anonymized analytics and advertising. Below you'll find an overview
        and explanation of each cookie — as well as how to manage them.
      </p>

      <p><em>Last updated: June 1, 2026</em></p>

      <h2>What are cookies?</h2>
      <p>
        Cookies are small text files stored on your device when you visit a
        website. They're used to remember settings, support security
        features, gather statistics and deliver ads. Some are set by the
        Dream Guide directly, others by third-party services we use.
      </p>
      <p>
        <strong>First-party cookies</strong> are set by drommeguiden.no
        itself. <strong>Third-party cookies</strong> are set by external
        providers — in our case Google Analytics, Google AdSense and
        Cloudflare. Both types appear in the table below, grouped by
        purpose: analytics, advertising and strictly necessary.
      </p>

      <h2>Cookies we use</h2>
      <p>
        The table below shows which cookies may be active on
        drommeguiden.no, which provider sets them, what they're used for,
        and how long they're stored. Analytics and advertising cookies
        require your active consent before they're activated.
      </p>

      <div class="cookie-table-wrapper">
        <table class="cookie-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Purpose</th>
              <th>Provider</th>
              <th>Duration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td colspan="4" class="cookie-table-group">Analytics — requires consent</td>
            </tr>
            <tr>
              <td><code>_ga</code></td>
              <td>Anonymized user ID used to distinguish between visitors</td>
              <td>Google Analytics</td>
              <td>2 years</td>
            </tr>
            <tr>
              <td><code>_ga_*</code></td>
              <td>GA4 session ID per property</td>
              <td>Google Analytics</td>
              <td>2 years</td>
            </tr>
            <tr>
              <td><code>_gid</code></td>
              <td>Daily user ID (may be active in some GA configurations)</td>
              <td>Google Analytics</td>
              <td>24 hours</td>
            </tr>

            <tr>
              <td colspan="4" class="cookie-table-group">Advertising — activated once ads are in place</td>
            </tr>
            <tr>
              <td><code>_gads</code></td>
              <td>Ad delivery and frequency capping</td>
              <td>Google AdSense</td>
              <td>13 months</td>
            </tr>
            <tr>
              <td><code>IDE</code></td>
              <td>Measurement and reporting of ad performance</td>
              <td>Google DoubleClick</td>
              <td>13 months</td>
            </tr>
            <tr>
              <td><code>__gpi</code></td>
              <td>Google publisher ID used for ad identification</td>
              <td>Google AdSense</td>
              <td>13 months</td>
            </tr>
            <tr>
              <td><code>NID</code></td>
              <td>User settings and personalization across Google's services</td>
              <td>Google</td>
              <td>6 months</td>
            </tr>

            <tr>
              <td colspan="4" class="cookie-table-group">Strictly necessary — cannot be disabled</td>
            </tr>
            <tr>
              <td><code>cf_clearance</code></td>
              <td>Confirms the visitor has passed Cloudflare's security check</td>
              <td>Cloudflare</td>
              <td>30 days</td>
            </tr>
            <tr>
              <td><code>__cf_bm</code></td>
              <td>Bot management and abuse protection</td>
              <td>Cloudflare</td>
              <td>30 minutes</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="cookie-note">
        Cookies marked <em>"activated once ads are in place"</em> are only
        set once AdSense has been enabled on the site — and only for users
        who consent to advertising.
      </p>

      <h2>How to withdraw consent</h2>
      <p>
        Once our consent solution is in place, you will find a
        <strong>"Cookie settings"</strong> link in the footer on every page.
        There you can turn off analytics or advertising cookies at any
        time, or withdraw your consent entirely.
      </p>

      <h2>How to manage cookies in your browser</h2>
      <p>
        You can also block or delete cookies through your browser's own
        settings. Note that blocking certain cookies may affect the
        functionality of the site.
      </p>
      <ul>
        <li><strong>Chrome:</strong> Settings &rarr; Privacy and security &rarr; Cookies</li>
        <li><strong>Firefox:</strong> Settings &rarr; Privacy & security &rarr; Cookies and site data</li>
        <li><strong>Safari:</strong> Settings &rarr; Privacy &rarr; Manage website data</li>
        <li><strong>Edge:</strong> Settings &rarr; Cookies and site permissions</li>
      </ul>

      <p>
        See also our <a href="/en/privacy/">privacy policy</a> for what data
        we process and what rights you have.
      </p>
    </div>
  </div>
</Base>

<style>
  .static-page {
    max-width: 820px;
    margin: 0 auto;
  }
  .static-label {
    display: block;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }
  .static-title {
    font-family: var(--font-heading);
    font-size: 36px;
    color: var(--color-text-heading);
    margin-bottom: 24px;
    font-weight: 400;
  }
  @media (min-width: 768px) {
    .static-title { font-size: 44px; }
  }

  .prose .lead {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text-body);
    padding: 18px 20px;
    background: rgba(123, 111, 160, 0.05);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 12px 12px 0;
    margin: 0 0 24px;
  }
  .prose code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.92em;
    padding: 1px 6px;
    background: rgba(123, 111, 160, 0.08);
    border-radius: 4px;
  }

  .cookie-table-wrapper {
    overflow-x: auto;
    margin: 20px 0 8px;
    border-radius: 12px;
    border: 1px solid rgba(123, 111, 160, 0.15);
  }
  .cookie-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.55;
    background: rgba(255, 255, 255, 0.6);
  }
  .cookie-table th,
  .cookie-table td {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid rgba(123, 111, 160, 0.1);
    vertical-align: top;
  }
  .cookie-table th {
    font-family: var(--font-nav);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: rgba(123, 111, 160, 0.06);
  }
  .cookie-table-group {
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(123, 111, 160, 0.04);
    padding: 8px 14px !important;
  }
  .cookie-table tr:last-child td {
    border-bottom: none;
  }
  .cookie-note {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 4px 0 28px;
  }
</style>
