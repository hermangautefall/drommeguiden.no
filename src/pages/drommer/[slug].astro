---
import { getCollection, render } from 'astro:content';
import Symbol from '../../layouts/Symbol.astro';
import { symbolAlternates } from '../../lib/symbol-alternates';

export async function getStaticPaths() {
  const artikler = await getCollection('drommer');
  return artikler.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Hreflang utledes av nb_slug for alle spraak, se lib/symbol-alternates.ts
const alternates = await symbolAlternates(entry.data.nb_slug ?? entry.data.slug);

const wordCount = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const leseminutter = Math.max(1, Math.round(wordCount / 200));
---

<Symbol
  tittel={entry.data.tittel}
  kortbeskrivelse={entry.data.kortbeskrivelse}
  tolkninger_kort={entry.data.tolkninger_kort}
  relaterte={entry.data.relaterte || []}
  slug={entry.data.slug}
  kategori={entry.data.kategori}
  dato={entry.data.dato}
  oppdatert={entry.data.oppdatert}
  bilde={entry.data.bilde}
  leseminutter={leseminutter}
  author={entry.data.author}
  sensitivt={entry.data.sensitivt}
  relaterte_sovn={entry.data.relaterte_sovn}
  lang="nb"
  alternates={alternates}
>
  <Content />
</Symbol>
