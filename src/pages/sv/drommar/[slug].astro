---
import { getCollection, render } from 'astro:content';
import Symbol from '../../../layouts/Symbol.astro';
import { pathFor } from '../../../i18n/utils';

export async function getStaticPaths() {
  const drommer = await getCollection('drommer-sv');
  return drommer.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const alleEn = await getCollection('drommer-en');

const wordCount = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const leseminutter = Math.max(1, Math.round(wordCount / 200));

const alternates: { lang: 'nb' | 'sv' | 'en'; url: string }[] = [
  { lang: 'sv', url: `https://drommeguiden.no${pathFor('sv', 'drommer', entry.data.slug)}` },
];
if (entry.data.nb_slug) {
  alternates.push({
    lang: 'nb',
    url: `https://drommeguiden.no${pathFor('nb', 'drommer', entry.data.nb_slug)}`,
  });
}
// EN kobles via felles nb_slug
const enMatch = entry.data.nb_slug
  ? alleEn.find((e: any) => e.data.nb_slug === entry.data.nb_slug)
  : undefined;
if (enMatch) {
  alternates.push({
    lang: 'en',
    url: `https://drommeguiden.no${pathFor('en', 'drommer', enMatch.data.slug)}`,
  });
}
---

<Symbol
  tittel={entry.data.tittel}
  kortbeskrivelse={entry.data.kortbeskrivelse}
  tolkninger_kort={entry.data.tolkninger_kort}
  relaterte={entry.data.relaterte || []}
  slug={entry.data.slug}
  kategori={entry.data.kategori}
  dato={entry.data.dato}
  oppdatert={entry.data.oppdatert}
  bilde={entry.data.bilde}
  leseminutter={leseminutter}
  author={entry.data.author}
  sensitivt={entry.data.sensitivt}
  relaterte_sovn={entry.data.relaterte_sovn}
  lang="sv"
  alternates={alternates}
>
  <Content />
</Symbol>
