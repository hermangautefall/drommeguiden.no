---
import Base from '../../layouts/Base.astro';
import DrommensDagSV from '../../components/DrommensDagSV.astro';
import SiteSchema from '../../components/SiteSchema.astro';
import { getCollection } from 'astro:content';

const drommer = await getCollection('drommer-sv');
const guider = await getCollection('guider-sv');
const sovn = await getCollection('sovn-sv');

// 4 featured sovn articles
const featuredSovnSlugs = ['somnfaser', 'somnhygien', 'angest-somn', 'melatonin'];
const featuredSovn = featuredSovnSlugs
  .map(slug => sovn.find(s => s.data.slug === slug))
  .filter(Boolean);

// 8 featured symbols — fills 3-col grid evenly with featured first card
const featuredSlugs = ['orm', 'hav', 'ex', 'tand', 'brand', 'flyga', 'hund', 'katt'];
const featuredSymboler = featuredSlugs
  .map(slug => drommer.find(d => d.data.slug === slug))
  .filter(Boolean);

const kategorier = [
  { slug: 'djur', tittel: 'Djur', emoji: '🐾' },
  { slug: 'vatten', tittel: 'Vatten', emoji: '🌊' },
  { slug: 'kropp', tittel: 'Kropp', emoji: '🫀' },
  { slug: 'platser', tittel: 'Platser', emoji: '🏠' },
  { slug: 'handelser', tittel: 'Händelser', emoji: '⚡' },
  { slug: 'manniskor', tittel: 'Människor', emoji: '👤' },
  { slug: 'natur', tittel: 'Natur', emoji: '🌿' },
  { slug: 'foremal', tittel: 'Föremål', emoji: '🔑' },
  { slug: 'andlig', tittel: 'Andligt', emoji: '✨' },
];

const kategorierMedAntall = kategorier.map(kat => ({
  ...kat,
  antall: drommer.filter(d => d.data.kategori === kat.slug).length,
}));

// Category SVG icons — same order as kategorier array (djur, vatten, kropp, platser, handelser, manniskor, natur, foremal, andlig)
const katIkoner = [
  // djur
  `<svg class="ic" viewBox="0 0 24 24"><circle cx="7" cy="9" r="1.7"/><circle cx="12" cy="7" r="1.7"/><circle cx="17" cy="9" r="1.7"/><path d="M12 11.5c-2.6 0-4.6 2-4.6 4 0 1.7 1.7 2.6 4.6 2.6s4.6-.9 4.6-2.6c0-2-2-4-4.6-4Z"/></svg>`,
  // vatten
  `<svg class="ic" viewBox="0 0 24 24"><path d="M3 9c2-1.6 4-1.6 6 0s4 1.6 6 0 4-1.6 6 0"/><path d="M3 15c2-1.6 4-1.6 6 0s4 1.6 6 0 4-1.6 6 0"/></svg>`,
  // kropp
  `<svg class="ic" viewBox="0 0 24 24"><path d="M12 19s-6.6-4.2-6.6-8.7A3.6 3.6 0 0 1 12 6.9a3.6 3.6 0 0 1 6.6 3.4C18.6 14.8 12 19 12 19Z"/></svg>`,
  // platser
  `<svg class="ic" viewBox="0 0 24 24"><path d="M4 11l8-6 8 6"/><path d="M6 10v8h12v-8"/></svg>`,
  // handelser
  `<svg class="ic" viewBox="0 0 24 24"><path d="M13 3 5 13.5h5.5l-1 7.5 8-11.5h-5.5l1-6.5Z"/></svg>`,
  // manniskor
  `<svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 19a6.5 6.5 0 0 1 13 0"/></svg>`,
  // natur
  `<svg class="ic" viewBox="0 0 24 24"><path d="M5 19c0-8 6-13.5 14-13.5C19 13.5 14 19.5 5.5 18.5"/><path d="M9 15.5c2-2.2 4.2-3.8 7.2-4.8"/></svg>`,
  // foremal
  `<svg class="ic" viewBox="0 0 24 24"><circle cx="8.5" cy="9" r="3.4"/><path d="M11 11.5 19 19.5"/><path d="M16.5 17l1.8-1.8M14.5 15l1.8-1.8"/></svg>`,
  // andlig
  `<svg class="ic" viewBox="0 0 24 24"><path d="M12 4c.6 4 1.7 5.1 5.7 5.7-4 .6-5.1 1.7-5.7 5.7-.6-4-1.7-5.1-5.7-5.7C10.3 9.1 11.4 8 12 4Z"/></svg>`,
];
---

<Base
  tittel="Drömguiden"
  beskrivelse="Ta reda på vad dina drömmar betyder. Komplett guide till drömsymboler och drömtolkning på svenska."
  lang="sv"
  canonicalUrl="https://drommeguiden.no/sv/"
  alternates={[
    { lang: 'nb', url: 'https://drommeguiden.no/' },
    { lang: 'sv', url: 'https://drommeguiden.no/sv/' },
  ]}
>

  <!-- 1. HERO -->
  <section class="hero-section">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-label">Drömguiden.no</p>
        <h1 class="hero-title">Vad drömde du<br /><em>i natt?</em></h1>
        <p class="hero-subtitle">
          Den svenska guiden till drömsymboler och drömtolkning. Förstå vad dina drömmar försöker säga dig.
        </p>

        <div class="hero-search-wrapper">
          <div class="hero-search-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <input
            type="text"
            id="sok"
            placeholder="Sök efter en drömsymbol..."
            autocomplete="off"
            class="hero-search-input"
          />
          <div
            id="sok-resultater"
            class="hero-search-results hidden"
          ></div>
          <button
            type="button"
            class="hero-search-go"
            aria-label="Sök"
            onclick="document.getElementById('sok').focus()"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
          </button>
        </div>

        <div class="hero-stats">
          <span class="hero-stat">{drommer.length} symboler</span>
          <span class="hero-stat">{kategorier.length} kategorier</span>
          <span class="hero-stat">{guider.length} guider</span>
        </div>
      </div>

      <div class="hero-dag-wrapper">
        <DrommensDagSV />
      </div>
    </div>
  </section>

  <!-- 2. QUOTE MARQUEE -->
  <div class="quote-marquee">
    <div class="quote-track">
      <span class="quote-item">« Drömmar är själens bildspråk »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Den som inte tolkar sina drömmar är som den som inte öppnar sina brev »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Drömmen är den lilla dolda dörren till själens innersta rum »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Allt vi ser eller tycker oss se är bara en dröm i en dröm »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Drömmar är själens bildspråk »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Den som inte tolkar sina drömmar är som den som inte öppnar sina brev »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Drömmen är den lilla dolda dörren till själens innersta rum »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
      <span class="quote-item">« Allt vi ser eller tycker oss se är bara en dröm i en dröm »</span>
      <span class="quote-dot" aria-hidden="true">✦</span>
    </div>
  </div>

  <!-- 3. POPULÄRA SYMBOLER -->
  <section class="section-block">
    <div class="section-header">
      <div>
        <p class="section-label">Utforska</p>
        <h2>Populära drömsymboler</h2>
      </div>
      <a href="/sv/drommar/" class="section-link">
        Se alla symboler
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="symbols-grid">
      {featuredSymboler.map((d) => d && (
        <a href={`/sv/drommar/${d.data.slug}/`} class="symbol-card">
          {d.data.bilde ? (
            <div class="symbol-card-image">
              <img src={d.data.bilde} alt={d.data.tittel} loading="lazy" />
            </div>
          ) : (
            <div class="symbol-card-image symbol-card-image-fallback"></div>
          )}
          <div class="symbol-card-body">
            <h3 class="symbol-card-title">
              {d.data.slug.replace(/-/g, ' ')}
            </h3>
            <p class="symbol-card-desc">{d.data.kortbeskrivelse}</p>
            <span class="symbol-card-cta">
              Läs tolkning
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. KATEGORIER -->
  <section class="section-block cats-section">
    <div class="cats-wrap">
      <div class="cats-head">
        <p class="section-label">Kategorier</p>
        <h2>Utforska efter tema</h2>
      </div>
      <div class="cat-grid">
        {kategorierMedAntall.map((kat, i) => (
          <a href={`/sv/kategori/${kat.slug}/`} class="cat">
            <span class="ico" set:html={katIkoner[i]}></span>
            <span class="cat-meta">
              <h4>{kat.tittel}</h4>
              <span>{kat.antall} symboler</span>
            </span>
          </a>
        ))}
        <!-- Dark "Alla" card -->
        <a href="/sv/kategori/" class="cat cat-alle">
          <span class="ico ico-alle">
            <svg class="ic" viewBox="0 0 24 24"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
          </span>
          <span class="cat-meta">
            <h4 class="cat-alle-title">Alla</h4>
            <span class="cat-alle-sub">{kategorier.length} kategorier</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. GUIDER -->
  {guider.length > 0 && (
    <section class="section-block">
      <div class="section-header">
        <div>
          <p class="section-label">Lär dig mer</p>
          <h2>Guider om drömmar</h2>
        </div>
        <a href="/sv/guider/" class="section-link">
          Alla guider
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
        </a>
      </div>

      {/* Featured guide */}
      {guider[0] && (
        <a href={`/sv/guider/${guider[0].data.slug}/`} class="guide-feature">
          {guider[0].data.bilde ? (
            <div class="guide-feature-img">
              <img src={guider[0].data.bilde} alt={guider[0].data.tittel} loading="lazy" />
            </div>
          ) : (
            <div class="guide-feature-img guide-feature-placeholder"></div>
          )}
          <div class="guide-feature-overlay"></div>
          <div class="gf-inner">
            {guider[0].data.leseminutter && (
              <div class="guide-feature-tag">{guider[0].data.leseminutter} min lästid</div>
            )}
            <h3>{guider[0].data.tittel}</h3>
            <p>{guider[0].data.kortbeskrivelse}</p>
          </div>
        </a>
      )}

      {/* Remaining guides */}
      <div class="guide-row">
        {guider.slice(1, 4).map((g) => (
          <a href={`/sv/guider/${g.data.slug}/`} class="gmini">
            <div class="gmini-img">
              {g.data.bilde ? (
                <img src={g.data.bilde} alt={g.data.tittel} loading="lazy" />
              ) : (
                <div class="gmini-placeholder"></div>
              )}
            </div>
            <div class="gmini-body">
              <h4>{g.data.tittel}</h4>
              {g.data.leseminutter && (
                <span>{g.data.leseminutter} min lästid</span>
              )}
            </div>
          </a>
        ))}
      </div>
      {guider.length > 4 && (
        <div class="section-cta">
          <a href="/sv/guider/" class="btn-secondary">Se alla {guider.length} guider</a>
        </div>
      )}
    </section>
  )}

  <!-- 6. SÖMN-SEKTION -->
  <section class="section-block">
    <div class="sleep">
      <span class="sleep-eyebrow">Sömnsektionen</span>
      <h2 class="sleep-title">Sömn och drömmar hör ihop</h2>
      <p class="sleep-intro">
        Drömmar sker under REM-sömn — och sömnkvaliteten påverkar direkt vad du drömmer.
        Utforska {sovn.length} artiklar om sömnvetenskap, sömnhygien och sömnproblem.
      </p>
      <div class="sleep-grid">
        {featuredSovn.map((s) => s && (
          <a href={`/sv/somn/${s.data.slug}/`} class="scard">
            {s.data.bilde && (
              <div class="scard-img">
                <img src={s.data.bilde} alt={s.data.tittel} loading="lazy" />
              </div>
            )}
            <div class="sc-body">
              <span>{s.data.leseminutter} min lästid</span>
              <h4>{s.data.tittel}</h4>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta">
        <a href="/sv/somn/" class="btn-primary">Utforska sömnsektionen →</a>
      </div>
    </div>
  </section>

  <!-- Schema -->
  <SiteSchema lang="sv" />

  <!-- Search script -->
  <script define:vars={{ symboler: drommer.map((d) => ({ tittel: d.data.tittel, slug: d.data.slug, kortbeskrivelse: d.data.kortbeskrivelse, lang: 'sv' })), siteLang: 'sv' }}>
    const sokInput = document.getElementById('sok');
    const resultaterDiv = document.getElementById('sok-resultater');

    if (sokInput && resultaterDiv) {
      sokInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (query.length < 2) {
          resultaterDiv.classList.add('hidden');
          resultaterDiv.innerHTML = '';
          return;
        }

        const treff = symboler
          .filter((s) => s.lang === siteLang)
          .filter(
            (s) =>
              s.slug.includes(query) ||
              s.tittel.toLowerCase().includes(query) ||
              s.kortbeskrivelse.toLowerCase().includes(query)
          )
          .slice(0, 6);

        if (treff.length === 0) {
          resultaterDiv.classList.add('hidden');
          resultaterDiv.innerHTML = '';
          return;
        }

        resultaterDiv.innerHTML = treff
          .map((s) => {
            const href = '/sv/drommar/' + s.slug + '/';
            const tittelKort = s.tittel.replace(/ — vad betyder det\?/, '');
            const beskKort = s.kortbeskrivelse.slice(0, 80);
            return '<a href="' + href + '" class="search-result-item">'
              + '<span class="search-result-title">' + tittelKort + '</span>'
              + '<span class="search-result-desc">' + beskKort + '…</span>'
              + '</a>';
          })
          .join('');
        resultaterDiv.classList.remove('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!sokInput.contains(e.target) && !resultaterDiv.contains(e.target)) {
          resultaterDiv.classList.add('hidden');
        }
      });

      if (new URLSearchParams(window.location.search).has('fokus')) {
        sokInput.focus();
      }
    }
  </script>
</Base>

<style>
  /* ================================================================
     SHARED ICON
     ================================================================ */
  .ic {
    width: 24px;
    height: 24px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ================================================================
     HERO
     ================================================================ */
  .hero-section {
    position: relative;
    margin: -2rem -1rem 0;
    padding: 56px 20px 36px;
    overflow: hidden;
  }
  /* varm morgensol-glød */
  .hero-section::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -220px;
    width: 720px;
    height: 720px;
    max-width: 135vw;
    transform: translateX(-50%);
    background: radial-gradient(circle at 50% 50%, rgba(201, 162, 90, .30), rgba(207, 139, 111, .12) 38%, transparent 64%);
    filter: blur(6px);
    pointer-events: none;
    z-index: 0;
    animation: sunbreathe 16s ease-in-out infinite;
  }
  @keyframes sunbreathe {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: .92; }
    50% { transform: translateX(-50%) scale(1.09); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-section::before { animation: none; }
  }
  @media (min-width: 768px) {
    .hero-section {
      margin: -2rem calc(-50vw + 50%) 0;
      padding: 86px 48px 64px;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero-inner {
      grid-template-columns: 1.35fr 0.9fr;
      gap: 60px;
    }
  }

  .hero-label {
    font-family: var(--font-nav);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 22px;
    font-weight: 600;
    animation: fadeInUp 0.6s ease-out both;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 52px;
    line-height: 0.98;
    color: var(--color-text-heading);
    margin-bottom: 26px;
    font-weight: 500;
    letter-spacing: -0.01em;
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }
  .hero-title em {
    font-style: italic;
    color: var(--color-accent);
  }
  @media (min-width: 480px) {
    .hero-title { font-size: 68px; }
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 88px; }
  }

  .hero-subtitle {
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 32ch;
    margin-bottom: 34px;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  /* ---- Search pill ---- */
  .hero-search-wrapper {
    position: relative;
    max-width: 440px;
    margin-bottom: 30px;
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  .hero-search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-faint);
    pointer-events: none;
    z-index: 1;
  }
  @media (min-width: 480px) {
    .hero-search-icon { left: 22px; }
  }

  .hero-search-input {
    width: 100%;
    padding: 16px 64px 16px 46px;
    border-radius: var(--border-radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-card);
    color: var(--color-text-body);
    font-size: 16px;
    font-family: var(--font-body);
    transition: box-shadow .25s, border-color .25s;
    box-shadow: 0 14px 40px -22px rgba(40, 30, 20, .5);
    text-overflow: ellipsis;
  }
  @media (min-width: 480px) {
    .hero-search-input {
      padding: 18px 64px 18px 54px;
    }
  }
  .hero-search-input::placeholder {
    color: var(--color-text-faint);
  }
  .hero-search-input:focus {
    outline: none;
    border-color: var(--color-clay-soft);
    box-shadow: 0 18px 50px -20px rgba(181, 106, 75, .45);
  }

  /* Submit button — dark circle on right edge */
  .hero-search-go {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: none;
    background: var(--color-bg-dark);
    color: var(--color-krem, #f2ede6);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s;
    flex-shrink: 0;
    z-index: 1;
  }
  .hero-search-go:hover {
    background: var(--color-accent);
  }

  .hero-search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    border-radius: var(--border-radius-card);
    overflow: hidden;
    z-index: 50;
    background: var(--color-bg-white);
    box-shadow: 0 16px 48px rgba(40, 30, 20, 0.18);
  }

  .hero-stats {
    display: flex;
    gap: 26px;
    align-items: center;
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }

  .hero-stat {
    font-size: 14px;
    color: var(--color-text-faint);
    font-family: var(--font-nav);
    letter-spacing: 0.3px;
    position: relative;
  }
  .hero-stat + .hero-stat::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.6;
  }

  .hero-dag-wrapper {
    background: var(--color-card);
    border-radius: 26px;
    border: 1px solid var(--color-line);
    box-shadow: 0 30px 70px -40px rgba(40, 30, 20, .4);
    overflow: hidden;
    animation: fadeInUp 0.8s ease-out 0.3s both;
  }
  @media (max-width: 767px) {
    .hero-dag-wrapper {
      max-width: 400px;
      margin: 0 auto;
    }
  }

  /* ================================================================
     QUOTE MARQUEE
     ================================================================ */
  .quote-marquee {
    overflow: hidden;
    padding: 28px 0;
