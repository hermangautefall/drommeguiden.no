---
import { getCollection, render } from 'astro:content';
import Kategori from '../../../layouts/Kategori.astro';
import { svToNo } from '../../../data/categoryMapping';

export async function getStaticPaths() {
  const kategorier = await getCollection('kategorier-sv');
  return kategorier.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const selfUrl = `https://drommeguiden.no/sv/kategori/${entry.data.slug}/`;
const nbSlug = svToNo[entry.data.slug];
const alternates: { lang: 'nb' | 'sv'; url: string }[] = [];
if (nbSlug) alternates.push({ lang: 'nb', url: `https://drommeguiden.no/kategori/${nbSlug}/` });
alternates.push({ lang: 'sv', url: selfUrl });
---

<Kategori
  tittel={entry.data.tittel}
  kortbeskrivelse={entry.data.kortbeskrivelse}
  slug={entry.data.slug}
  lang="sv"
  alternates={alternates}
>
  <Content />
</Kategori>
