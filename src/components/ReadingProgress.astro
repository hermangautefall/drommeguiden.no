---
// Tynn lese-fremdriftsbar øverst på siden.
// Brukes på lange leseruter (/drommer/*, /sovn/*).
---

<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress-fill" id="reading-progress-fill"></div>
</div>

<script>
  const fill = document.getElementById('reading-progress-fill');
  if (fill) {
    let ticking = false;

    const update = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;
      fill.style.transform = `scaleX(${progress})`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(15, 19, 40, 0.85);
    z-index: 100;
    pointer-events: none;
  }

  .reading-progress-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #d97b4a 0%, #c08070 100%);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.05s linear;
    will-change: transform;
  }
</style>
