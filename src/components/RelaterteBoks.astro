---
import { defaultLang, type Lang } from '../i18n/config';
import { pathFor } from '../i18n/utils';
import { symbolerSomFinnes } from '../lib/finnes-symbol';

interface Props {
  relaterte: string[];
  lang?: Lang;
}

const { relaterte, lang = defaultLang } = Astro.props;
const labelByLang: Record<Lang, string> = { nb: 'Utforsk videre', sv: 'Utforska vidare', en: 'Explore further' };
const label = labelByLang[lang] ?? labelByLang.nb;
const titleByLang: Record<Lang, string> = { nb: 'Relaterte drømmesymboler', sv: 'Relaterade drömsymboler', en: 'Related dream symbols' };
const title = titleByLang[lang] ?? titleByLang.nb;

// Dropp slugger uten artikkel — de ble tidligere rendret som doede lenker
const finnes = symbolerSomFinnes(lang);
const gyldige = relaterte.filter((s) => finnes.has(s));
---

{gyldige.length > 0 && (
  <div class="relaterte-section">
    <span class="relaterte-label">{label}</span>
    <h2 class="relaterte-title">{title}</h2>
    <div class="relaterte-grid">
      {gyldige.map((slug) => (
        <a href={pathFor(lang, 'drommer', slug)} class="relaterte-chip">
          {slug.replace(/-/g, ' ')}
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .relaterte-section {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(123, 111, 160, 0.1);
  }

  .relaterte-label {
    display: block;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  .relaterte-title {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--color-text-heading);
    margin-bottom: 16px;
    font-weight: 400;
  }
  @media (min-width: 480px) {
    .relaterte-title { font-size: 24px; }
  }

  .relaterte-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .relaterte-chip {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(123, 111, 160, 0.12);
    color: var(--color-text-body);
    padding: 8px 16px;
    border-radius: var(--border-radius-pill);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    text-transform: capitalize;
    transition: all 0.2s ease;
  }
  .relaterte-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(123, 111, 160, 0.2);
  }
</style>
