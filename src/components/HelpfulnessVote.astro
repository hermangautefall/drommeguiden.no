---
import { defaultLang, type Lang } from '../i18n/config';

interface Props {
  slug: string;
  lang?: Lang;
}

const { slug, lang = defaultLang } = Astro.props;

const labelsByLang: Record<Lang, { question: string; yes: string; no: string; thanks: string }> = {
  nb: {
    question: 'Hjalp denne tolkningen?',
    yes: 'Ja',
    no: 'Ikke helt',
    thanks: 'Takk for tilbakemeldingen!',
  },
  sv: {
    question: 'Hjälpte denna tolkning?',
    yes: 'Ja',
    no: 'Inte riktigt',
    thanks: 'Tack för din feedback!',
  },
  en: {
    question: 'Was this interpretation helpful?',
    yes: 'Yes',
    no: 'Not really',
    thanks: 'Thanks for the feedback!',
  },
};
const labels = labelsByLang[lang] ?? labelsByLang.nb;
---

<aside class="helpfulness" data-helpfulness data-slug={slug} aria-label={labels.question}>
  <span class="helpfulness-q">{labels.question}</span>
  <div class="helpfulness-buttons" data-helpfulness-buttons>
    <button type="button" class="helpfulness-btn" data-helpfulness-btn data-value="helpful">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
      </svg>
      <span>{labels.yes}</span>
    </button>
    <button type="button" class="helpfulness-btn" data-helpfulness-btn data-value="not_helpful">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/>
      </svg>
      <span>{labels.no}</span>
    </button>
  </div>
  <span class="helpfulness-thanks" data-helpfulness-thanks hidden>{labels.thanks}</span>
</aside>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-helpfulness]').forEach(function (root) {
      const slug = root.getAttribute('data-slug');
      if (!slug) return;
      const key = 'vote:' + slug;
      const thanks = root.querySelector('[data-helpfulness-thanks]');
      const buttons = root.querySelectorAll('[data-helpfulness-btn]');

      function markVoted(value) {
        buttons.forEach(function (b) {
          b.disabled = true;
          if (b.getAttribute('data-value') === value) {
            b.classList.add('helpfulness-btn-selected');
          }
        });
        if (thanks) thanks.hidden = false;
      }

      // Allerede stemt? Reaktiver tidligere valg.
      try {
        const prior = localStorage.getItem(key);
        if (prior) markVoted(prior);
      } catch (e) { /* localStorage avslått */ }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.disabled) return;
          const value = btn.getAttribute('data-value');
          if (!value) return;
          try { localStorage.setItem(key, value); } catch (e) {}
          markVoted(value);
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'helpfulness_vote', {
              slug: slug,
              value: value,
            });
          }
        });
      });
    });
  })();
</script>

<style>
  .helpfulness {
    margin: 40px 0 0;
    padding: 20px 0;
    border-top: 1px solid rgba(123, 111, 160, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .helpfulness-q {
    font-family: var(--font-nav);
    font-size: 14px;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.2px;
  }

  .helpfulness-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .helpfulness-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    min-block-size: 36px;
    border-radius: var(--border-radius-pill, 100px);
    background: transparent;
    border: 1px solid rgba(123, 111, 160, 0.18);
    color: var(--color-text-muted);
    font-family: var(--font-nav);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .helpfulness-btn:hover:not(:disabled) {
    background: rgba(123, 111, 160, 0.06);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .helpfulness-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .helpfulness-btn:disabled {
    cursor: default;
    opacity: 0.5;
  }
  .helpfulness-btn-selected {
    background: var(--color-primary) !important;
    color: #fff !important;
    border-color: var(--color-primary) !important;
    opacity: 1 !important;
  }
  .helpfulness-btn svg {
    flex-shrink: 0;
  }

  .helpfulness-thanks {
    font-size: 13px;
    color: #1D9E75;
    font-weight: 500;
  }
</style>
