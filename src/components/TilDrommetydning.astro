---
/**
 * Bro fra symbolbetydning tilbake til drømmetydning.
 *
 * NB: ikke det samme som RelaterteDrommer.astro, som Sovn.astro bruker for
 * å vise symbolkort med utgangspunkt i ferdig hentede artikkelobjekter.
 * Denne tar slugger og filtrerer dem selv.
 *
 * Bruker samme filter som RelaterteBoks: en slug uten artikkel droppes
 * stille, saa en feilskrevet slug blir en manglende brikke i stedet for
 * en død lenke. Lenker alltid til drømmeartikkelen paa samme spraak.
 */
import { defaultLang, type Lang } from '../i18n/config';
import { pathFor } from '../i18n/utils';
import { symbolerSomFinnes } from '../lib/finnes-symbol';
import { symbolEtiketter } from '../lib/symbol-etikett';

interface Props {
  slugs: string[];
  lang?: Lang;
}

const { slugs, lang = defaultLang } = Astro.props;
const labelByLang: Record<Lang, string> = { nb: 'Drømte du det i stedet?', sv: 'Drömde du det i stället?', da: 'Drømte du det i stedet?', en: 'Did you dream it instead?' };
const titleByLang: Record<Lang, string> = {
  nb: 'Les drømmetydningen',
  sv: 'Läs drömtydningen',
  da: 'Læs drømmetydningen',
  en: 'Read the dream interpretation',
};
const label = labelByLang[lang] ?? labelByLang.nb;
const title = titleByLang[lang] ?? titleByLang.nb;

const finnes = symbolerSomFinnes(lang);
const gyldige = slugs.filter((s) => finnes.has(s));
const etiketter = symbolEtiketter(lang);
---

{gyldige.length > 0 && (
  <div class="relaterte-section">
    <span class="relaterte-label">{label}</span>
    <h2 class="relaterte-title">{title}</h2>
    <div class="relaterte-grid">
      {gyldige.map((slug) => (
        <a href={pathFor(lang, 'drommer', slug)} class="relaterte-chip">
          {etiketter.get(slug) ?? slug.replace(/-/g, ' ')}
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .relaterte-section {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(123, 111, 160, 0.1);
  }

  .relaterte-label {
    display: block;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  .relaterte-title {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--color-text-heading);
    margin-bottom: 16px;
    font-weight: 400;
  }
  @media (min-width: 480px) {
    .relaterte-title { font-size: 24px; }
  }

  .relaterte-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .relaterte-chip {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(123, 111, 160, 0.12);
    color: var(--color-text-body);
    padding: 8px 16px;
    border-radius: var(--border-radius-pill);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .relaterte-chip:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(123, 111, 160, 0.2);
  }
</style>
