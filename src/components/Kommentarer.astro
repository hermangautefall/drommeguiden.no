---
// Giscus comment system component.
// Hvis giscus-scriptet feiler å laste, eller iframen ikke har innhold
// etter 3000ms, skjules .giscus-wrapper og en tekst "Snart kommer
// kommentarer her" vises i stedet. Slik unngår vi at utloggede brukere
// ser en tom grå firkant nederst på siden.
---

<section class="kommentarer-section">
  <span class="kommentarer-label">Delta i samtalen</span>
  <h2 class="kommentarer-title">Kommentarer</h2>
  <p class="kommentarer-desc">
    Har du drømt noe lignende? Del din opplevelse eller still et spørsmål.
  </p>
  <div class="giscus-wrapper" id="giscus-wrapper">
    <script
      id="giscus-script"
      src="https://giscus.app/client.js"
      data-repo="hermangautefall/drommeguiden.no"
      data-repo-id="R_kgDORpoPww"
      data-category="Announcements"
      data-category-id="DIC_kwDORpoPw84C4uXs"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="nb"
      crossorigin="anonymous"
      async
      onerror="window.__giscusFailed=true;"
    ></script>
  </div>
  <p class="kommentarer-fallback" id="kommentarer-fallback" hidden>
    Snart kommer kommentarer her
  </p>
</section>

<script is:inline>
  (function () {
    var wrapper = document.getElementById('giscus-wrapper');
    var fallback = document.getElementById('kommentarer-fallback');
    if (!wrapper || !fallback) return;

    setTimeout(function () {
      var iframe = wrapper.querySelector('iframe');
      var scriptFailed = window.__giscusFailed === true;
      var hasContent = iframe && iframe.offsetHeight > 50;

      if (scriptFailed || !hasContent) {
        wrapper.style.display = 'none';
        fallback.hidden = false;
      }
    }, 3000);
  })();
</script>

<style>
  .kommentarer-section {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(123, 111, 160, 0.1);
  }

  .kommentarer-label {
    display: block;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  .kommentarer-title {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--color-text-heading);
    font-weight: 400;
    margin: 0 0 6px 0;
  }

  .kommentarer-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .giscus-wrapper {
    min-height: 180px;
  }

  .kommentarer-fallback {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    padding: 24px 0;
    font-style: italic;
  }
</style>
