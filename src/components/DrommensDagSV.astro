---
import { getCollection } from 'astro:content';

const alleSymboler = await getCollection('drommer-sv');
// Sensitive symboler (overfall, dodsfall, sykdom, selvskading ...) holdes
// utenfor rotasjonen. De hoerer hjemme i samlingen, men ikke som dagens
// utvalgte pa forsiden — det er det forste en ny leser moter.
const egnetForForsiden = alleSymboler.filter((s: any) => !s.data.sensitivt);
const sorterteSymboler = [...egnetForForsiden].sort((a, b) => a.data.slug.localeCompare(b.data.slug));

const symbolData = sorterteSymboler.map(s => ({
  slug: s.data.slug,
  navn: s.data.tittel.replace(/ — vad betyder det\?/, '').replace('Drömmar om ', '').replace('Drömma om ', ''),
  desc: s.data.kortbeskrivelse || '',
  bilde: s.data.bilde || '',
}));

// Symbolet roterer per dag. Tidligere ble hele samlingen (~49 kB JSON) sendt
// til klienten, og selve kortet stod som "Laster..." i HTML-en — det var alt
// en crawler eller en leser uten JS fikk se. Na regnes byggedagens symbol ut
// her og rendres direkte, mens klienten bare far et lite vindu med de neste
// dagene og oppdaterer kortet hvis leserens lokale dato er en annen.
const MS_PER_DAG = 86400000;
const byggDag = Math.floor(Date.now() / MS_PER_DAG);
const dagensSymbol = symbolData[byggDag % symbolData.length];
const vindu = Object.fromEntries(
  Array.from({ length: 60 }, (_, i) => [byggDag + i, symbolData[(byggDag + i) % symbolData.length]]),
);
---

<script is:inline define:vars={{ vindu }}>
  window.__drommensDataSV = vindu;
</script>

<div class="drommens-dag-wrapper" id="drommens-dag-sv">
  <p class="dag-label">✦ DAGENS SYMBOL</p>
  <div class={dagensSymbol.bilde ? "dag-image" : "dag-image dag-image-fallback"} id="dag-image-container-sv">{dagensSymbol.bilde ? <img src={dagensSymbol.bilde} alt={dagensSymbol.navn} loading="lazy" /> : '✨'}</div>
  <h2 class="dag-navn" id="dag-navn-sv">{dagensSymbol.navn}</h2>
  <p class="dag-beskrivelse" id="dag-beskrivelse-sv">{dagensSymbol.desc}</p>
  <div class="dag-separator"></div>
  <a href={`/sv/drommar/${dagensSymbol.slug}/`} class="dag-link hover:no-underline" id="dag-link-sv">
    Läs full tolkning <span aria-hidden="true">&rarr;</span>
  </a>
  <p class="dag-dato" id="dag-dato-sv"></p>
</div>

<script is:inline>
  (function() {
    var now = new Date();
    var datoEl = document.getElementById('dag-dato-sv');
    var months = ['januari','februari','mars','april','maj','juni','juli','augusti','september','oktober','november','december'];
    if (datoEl) datoEl.textContent = now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();

    // Kortet er allerede rendret med byggedagens symbol. Vinduet dekker de
    // neste 60 dagene; er leserens dato utenfor, star det rendrede igjen.
    var data = window.__drommensDataSV;
    var symbol = data && data[Math.floor(now.getTime() / 86400000)];
    if (!symbol) return;

    var navnEl = document.getElementById('dag-navn-sv');
    var descEl = document.getElementById('dag-beskrivelse-sv');
    var linkEl = document.getElementById('dag-link-sv');
    var imgContainer = document.getElementById('dag-image-container-sv');

    if (navnEl) navnEl.textContent = symbol.navn;
    if (descEl) descEl.textContent = symbol.desc;
    if (linkEl) linkEl.href = '/sv/drommar/' + symbol.slug + '/';
    if (imgContainer && symbol.bilde) {
      imgContainer.className = 'dag-image';
      imgContainer.innerHTML = '<img src="' + symbol.bilde + '" alt="' + symbol.navn + '" loading="lazy" />';
    }
  })();
</script>

<style>
  .drommens-dag-wrapper {
    text-align: center;
    padding: 38px 36px 34px;
    animation: fadeInUp 0.8s ease-out;
  }

  .dag-label {
    font-family: var(--font-nav);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 24px;
  }

  .dag-image {
    width: 128px;
    height: 128px;
    margin: 0 auto 22px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: inset -14px -16px 34px rgba(120, 95, 55, .22), 0 18px 40px -18px rgba(150, 120, 70, .5);
    animation: fadeInScale 1s ease-out 0.3s both;
  }
  .dag-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dag-image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52px;
    border: none;
    background: radial-gradient(circle at 36% 32%, #fbf6ec, #e6d6bd 46%, #cbb489 100%);
  }

  .dag-navn {
    font-family: var(--font-heading);
    font-size: 44px;
    color: var(--color-text-heading);
    margin-bottom: 14px;
    font-weight: 500;
    text-transform: lowercase;
  }

  .dag-beskrivelse {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 32ch;
    margin: 0 auto 22px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dag-separator {
    width: 34px;
    height: 1px;
    background: var(--color-line);
    margin: 0 auto 22px;
  }

  .dag-link {
    font-family: var(--font-nav);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s ease, opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .dag-link:hover {
    gap: 13px;
  }

  .dag-dato {
    font-family: var(--font-nav);
    font-size: 12px;
    color: var(--color-text-faint);
    letter-spacing: 0.04em;
    margin-top: 22px;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }
</style>
