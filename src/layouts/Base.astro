---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import { languages, defaultLang, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface AlternateLink {
  lang: Lang;
  url: string;
}

type PageType = 'website' | 'article';

interface Props {
  tittel: string;
  beskrivelse: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: PageType;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  lang?: Lang;
  alternates?: AlternateLink[];
  progress?: boolean;
  /** Sett true for sider uten reelt innhold (f.eks. tomme listesider),
      så de ikke indekseres som tynt innhold. */
  noindex?: boolean;
}

const {
  tittel,
  beskrivelse,
  canonicalUrl,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  lang = defaultLang,
  alternates = [],
  progress = false,
  noindex = false,
} = Astro.props;

const SITE = 'https://drommeguiden.no';
const canonical = canonicalUrl || Astro.url.href;
const langConfig = languages[lang];
const t = useTranslations(lang);

// Tittel: unngå dublering "Drømmeguiden | Drømmeguiden" på rotsiden
const brand = langConfig.brand;
const isRoot = tittel.trim() === brand;
const fullTitle = isRoot ? brand : `${tittel} | ${brand}`;

// OG-bilde: språkspesifikt branded standardbilde brukes hvis ikke en
// per-side override er sendt inn. Standardbildet er alltid 1200×630.
// Per-språk OG-bilde.
const ogImageByLang: Record<string, string> = { nb: '/og-no.png', sv: '/og-sv.png', en: '/og-en.jpg' };
const defaultOgImage = ogImageByLang[lang] ?? '/og-no.png';
const usingDefault = !ogImage;
const resolvedOgImage = ogImage || defaultOgImage;
const ogImageAbsolute = /^https?:\/\//i.test(resolvedOgImage)
  ? resolvedOgImage
  : `${SITE}${resolvedOgImage.startsWith('/') ? resolvedOgImage : '/' + resolvedOgImage}`;
const ogW = usingDefault ? 1200 : (ogImageWidth ?? 1200);
const ogH = usingDefault ? 630  : (ogImageHeight ?? 630);
const ogImageAlt = isRoot ? brand : `${brand} – ${tittel}`;

function toIso(v?: Date | string): string | undefined {
  if (!v) return undefined;
  if (v instanceof Date) return v.toISOString();
  const d = new Date(v);
  return isNaN(d.getTime()) ? undefined : d.toISOString();
}
const publishedIso = toIso(publishedTime);
const modifiedIso = toIso(modifiedTime) || publishedIso;

// hreflang defaults: always link to self + NO default; include SV if provided
const hreflangLinks = [
  ...alternates.map(a => ({
    hreflang: languages[a.lang].htmlLang,
    href: a.url,
  })),
  // x-default points to Norwegian version if available
  ...(alternates.find(a => a.lang === 'nb')
    ? [{ hreflang: 'x-default', href: alternates.find(a => a.lang === 'nb')!.url }]
    : []),
];
---

<!doctype html>
<html lang={langConfig.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6610380824794050" crossorigin="anonymous"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={beskrivelse} />
    <!-- Favicon: SVG for moderne nettlesere, PNG som reserve -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1c1916" />

    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {hreflangLinks.map(link => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content={String(ogW)} />
    <meta property="og:image:height" content={String(ogH)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={langConfig.locale} />
    {alternates.filter(a => a.lang !== lang).map(a => (
      <meta property="og:locale:alternate" content={languages[a.lang].locale} />
    ))}
    {type === 'article' && publishedIso && (
      <meta property="article:published_time" content={publishedIso} />
    )}
    {type === 'article' && modifiedIso && (
      <meta property="article:modified_time" content={modifiedIso} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={beskrivelse} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles -->
    <style>
      @import '../styles/global.css';
    </style>

    <!-- Typografi for markdown-innhold. Maa vaere is:global: innhold fra
         markdown faar ikke Astros scope-attributt, saa scopede .prose-regler
         traff aldri artikkelteksten. Foer dette falt brodtekstlenker tilbake
         til nettleserens standardblaa. -->
    <style is:global>
      @import '../styles/prose.css';
    </style>

    <!-- Touch targets (WCAG 2.5.5 / Apple HIG — 80% mobil, iOS Safari).
         Truly global (is:global) så regelen treffer elementer på tvers
         av komponenter. .prose a bevisst utelatt for ikke å bryte
         linjehøyden på inline brødtekstlenker. Scoped til mobil-bredde
         (<768px) slik at desktop-layouten ikke endres. -->
    <style is:global>
      @media (max-width: 767px) {
        :where(button, [role="button"]) {
          min-block-size: 44px;
        }
        :where(
          .footer-links a,
          .relaterte-chip,
          .category-card,
          .kategori-card,
          .section-link
        ) {
          min-block-size: 44px;
        }
        :where(.footer-links a, .section-link) {
          display: inline-flex;
          align-items: center;
        }
      }
    </style>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XB1F95Y3GZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XB1F95Y3GZ');
    </script>

    <!-- Ezoic head script placeholder -->
    <!-- <script async src="//www.ezojs.com/ezoic/sa.min.js"></script> -->

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-pattern" style="background-color: var(--color-bg-cream); color: var(--color-text-body);">
    <div class="site-bg" aria-hidden="true">
      <div class="waves">
        <div class="wave w1"></div>
        <div class="wave w2"></div>
        <div class="wave w3"></div>
      </div>
      <div class="shape blob1"></div>
      <div class="shape blob2"></div>
      <div class="shape blob3"></div>
      <div class="system s1">
        <div class="ring r3"><span class="moon"></span></div>
        <div class="ring r2"><span class="moon sm"></span></div>
        <div class="ring r1"><span class="moon"></span></div>
      </div>
      <div class="system s2">
        <div class="ring r2"><span class="moon sm"></span></div>
        <div class="ring r1"><span class="moon"></span></div>
      </div>
    </div>
    {progress && <ReadingProgress />}
    <Header lang={lang} alternates={alternates} />

    <main class="flex-1 max-w-5xl mx-auto px-4 py-10 w-full">
      <slot />
    </main>

    <Footer lang={lang} />
    {progress && <BackToTop lang={lang} />}
  </body>
</html>
