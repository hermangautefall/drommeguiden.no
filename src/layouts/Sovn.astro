---
import Base from './Base.astro';
import BildeKreditt from '../components/BildeKreditt.astro';
import Kommentarer from '../components/Kommentarer.astro';
import ContentTOC from '../components/ContentTOC.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AdSlot from '../components/AdSlot.astro';
import HelpfulnessVote from '../components/HelpfulnessVote.astro';
import { getAuthor } from '../data/authors';
import { resolveOgImage } from '../lib/og-image';
import RelaterteDrommer from '../components/RelaterteDrommer.astro';
import { getCollection } from 'astro:content';
import { defaultLang, languages, type Lang } from '../i18n/config';
import { pathFor, homePath } from '../i18n/utils';

interface AlternateLink {
  lang: Lang;
  url: string;
}

interface Props {
  tittel: string;
  kortbeskrivelse: string;
  slug: string;
  kategori: string;
  leseminutter: number;
  dato: Date;
  oppdatert?: Date;
  bilde?: string;
  relaterte_sovn?: string[];
  // Lenker til symbol-slugs (drommer-kollektionen)
  relaterte_drommer?: string[];
  // Lenker til guide-slugs (guider-kollektionen) — tidligere het feltet
  // `relaterte_drommer` men er nå omdøpt så navnet matcher data
  relaterte_guider?: string[];
  author?: string;
  lang?: Lang;
  alternates?: AlternateLink[];
}

const { tittel, kortbeskrivelse, slug, kategori, leseminutter, dato, oppdatert, bilde, relaterte_sovn, relaterte_drommer, relaterte_guider, author, lang = defaultLang, alternates = [] } = Astro.props;
const resolvedAuthor = getAuthor(author);
const og = await resolveOgImage(bilde);
const bildeFilnavn = bilde ? bilde.split('/').pop() : undefined;
const langConfig = languages[lang];

const kategoriMapNb: Record<string, { label: string; color: string; bg: string }> = {
  vitenskap: { label: 'Søvnvitenskap', color: '#7B6FA0', bg: 'rgba(123, 111, 160, 0.1)' },
  hygiene: { label: 'Søvnhygiene', color: '#1D9E75', bg: 'rgba(29, 158, 117, 0.1)' },
  lidelser: { label: 'Søvnlidelser', color: '#C07050', bg: 'rgba(192, 112, 80, 0.1)' },
  livsfaser: { label: 'Livsfaser', color: '#4A8BBF', bg: 'rgba(74, 139, 191, 0.1)' },
  produkter: { label: 'Produkter', color: '#B8960C', bg: 'rgba(184, 150, 12, 0.1)' },
  psykologi: { label: 'Søvnpsykologi', color: '#9B7FBF', bg: 'rgba(155, 127, 191, 0.1)' },
};
const kategoriMapSv: Record<string, { label: string; color: string; bg: string }> = {
  vitenskap: { label: 'Sömnvetenskap', color: '#7B6FA0', bg: 'rgba(123, 111, 160, 0.1)' },
  hygiene: { label: 'Sömnhygien', color: '#1D9E75', bg: 'rgba(29, 158, 117, 0.1)' },
  lidelser: { label: 'Sömnstörningar', color: '#C07050', bg: 'rgba(192, 112, 80, 0.1)' },
  livsfaser: { label: 'Livsfaser', color: '#4A8BBF', bg: 'rgba(74, 139, 191, 0.1)' },
  produkter: { label: 'Produkter', color: '#B8960C', bg: 'rgba(184, 150, 12, 0.1)' },
  psykologi: { label: 'Sömnpsykologi', color: '#9B7FBF', bg: 'rgba(155, 127, 191, 0.1)' },
};
const kategoriMapEn: Record<string, { label: string; color: string; bg: string }> = {
  vitenskap: { label: 'Sleep science', color: '#7B6FA0', bg: 'rgba(123, 111, 160, 0.1)' },
  hygiene: { label: 'Sleep hygiene', color: '#1D9E75', bg: 'rgba(29, 158, 117, 0.1)' },
  lidelser: { label: 'Sleep disorders', color: '#C07050', bg: 'rgba(192, 112, 80, 0.1)' },
  livsfaser: { label: 'Life stages', color: '#4A8BBF', bg: 'rgba(74, 139, 191, 0.1)' },
  produkter: { label: 'Products', color: '#B8960C', bg: 'rgba(184, 150, 12, 0.1)' },
  psykologi: { label: 'Sleep psychology', color: '#9B7FBF', bg: 'rgba(155, 127, 191, 0.1)' },
};
const kategoriMapByLang: Record<Lang, Record<string, { label: string; color: string; bg: string }>> = {
  nb: kategoriMapNb,
  sv: kategoriMapSv,
  en: kategoriMapEn,
};
const kategoriMap = kategoriMapByLang[lang] ?? kategoriMapByLang.nb;
const kat = kategoriMap[kategori] || kategoriMap.vitenskap;

const labelsByLang: Record<Lang, { hjem: string; sovn: string; breadcrumb: string; lesetid: string; oppdatert: string; innhold: string; relatert: string; lesMer: string; fraGuiden: string; drommerOgSovn: string; guideLabel: string; dateLocale: string }> = {
  nb: { hjem: 'Hjem', sovn: 'Søvn', breadcrumb: 'Brødsmuler', lesetid: 'min lesetid', oppdatert: 'Oppdatert', innhold: 'Innhold', relatert: 'Relatert', lesMer: 'Les mer om søvn', fraGuiden: 'Fra drømmeguiden', drommerOgSovn: 'Drømmer og søvn', guideLabel: 'Guide', dateLocale: 'nb-NO' },
  sv: { hjem: 'Hem', sovn: 'Sömn', breadcrumb: 'Brödsmulor', lesetid: 'min läsning', oppdatert: 'Uppdaterad', innhold: 'Innehåll', relatert: 'Relaterat', lesMer: 'Läs mer om sömn', fraGuiden: 'Från drömguiden', drommerOgSovn: 'Drömmar och sömn', guideLabel: 'Guide', dateLocale: 'sv-SE' },
  en: { hjem: 'Home', sovn: 'Sleep', breadcrumb: 'Breadcrumbs', lesetid: 'min read', oppdatert: 'Updated', innhold: 'Contents', relatert: 'Related', lesMer: 'Read more about sleep', fraGuiden: 'From the dream guide', drommerOgSovn: 'Dreams and sleep', guideLabel: 'Guide', dateLocale: 'en-GB' },
};
const labels = labelsByLang[lang] ?? labelsByLang.nb;

const sovnCollectionByLang: Record<Lang, string> = { nb: 'sovn', sv: 'sovn-sv', en: 'sovn-en' };
const sovnCollection = sovnCollectionByLang[lang] ?? sovnCollectionByLang.nb;
const guiderCollectionByLang: Record<Lang, string> = { nb: 'guider', sv: 'guider-sv', en: 'guider-en' };
const guiderCollection = guiderCollectionByLang[lang] ?? guiderCollectionByLang.nb;

const alleSovn = await getCollection(sovnCollection as any);
const relaterteSovnArtikler = (relaterte_sovn || [])
  .map(s => alleSovn.find((a: any) => a.data.slug === s))
  .filter(Boolean);

const alleGuider = await getCollection(guiderCollection as any);
const relaterteGuiderArtikler = (relaterte_guider || [])
  .map(s => alleGuider.find((g: any) => g.data.slug === s))
  .filter(Boolean);

const drommerCollectionByLang: Record<Lang, string> = { nb: 'drommer', sv: 'drommer-sv', en: 'drommer-en' };
const drommerCollection = drommerCollectionByLang[lang] ?? drommerCollectionByLang.nb;
const alleDrommer = await getCollection(drommerCollection as any);
const relaterteDrommerArtikler = (relaterte_drommer || [])
  .map(s => alleDrommer.find((d: any) => d.data.slug === s))
  .filter(Boolean);

const baseSite = 'https://drommeguiden.no';
const canonical = `${baseSite}${pathFor(lang, 'sovn', slug)}`;

const aboutUrlByLang: Record<Lang, string> = { nb: '/om-oss/', sv: '/sv/om-oss/', en: '/en/about/' };
const aboutUrl = aboutUrlByLang[lang] ?? aboutUrlByLang.nb;
const bylineLabelByLang: Record<Lang, string> = { nb: 'Skrevet av', sv: 'Skriven av', en: 'Written by' };
const bylineLabel = bylineLabelByLang[lang] ?? bylineLabelByLang.nb;
const oppdatertDato = oppdatert ?? dato;
const oppdatertFmt = oppdatertDato.toLocaleDateString(labels.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });

const disclaimerByLang: Record<Lang, string> = {
  nb: 'Denne artikkelen er ment som generell informasjon og refleksjon, ikke medisinsk rådgivning. Ved vedvarende søvnproblemer eller alvorlige plager, oppsøk fastlege eller annet helsepersonell.',
  sv: 'Den här artikeln är tänkt som allmän information och reflektion, inte medicinsk rådgivning. Vid ihållande sömnproblem eller allvarliga besvär bör du kontakta vårdcentral eller annan vårdpersonal.',
  en: 'This article is meant as general information and reflection, not medical advice. If you have persistent sleep problems or serious symptoms, please see a doctor or other healthcare professional.',
};
const disclaimer = disclaimerByLang[lang] ?? disclaimerByLang.nb;
const disclaimerLabelByLang: Record<Lang, string> = { nb: 'Viktig', sv: 'Viktigt', en: 'Important' };
const disclaimerLabel = disclaimerLabelByLang[lang] ?? disclaimerLabelByLang.nb;

const crumbs = [
  { name: labels.hjem, url: homePath(lang) },
  { name: labels.sovn, url: pathFor(lang, 'sovn') },
  { name: tittel,      url: pathFor(lang, 'sovn', slug) },
];
---

<Base
  tittel={tittel}
  beskrivelse={kortbeskrivelse}
  canonicalUrl={canonical}
  type="article"
  publishedTime={dato}
  modifiedTime={oppdatert ?? dato}
  author={resolvedAuthor.name}
  ogImage={og?.url}
  ogImageWidth={og?.width}
  ogImageHeight={og?.height}
  lang={lang}
  alternates={alternates}
  progress={true}
>
  <article class="sovn-article">
    <!-- Breadcrumb -->
    <nav class="sovn-breadcrumb" aria-label={labels.breadcrumb}>
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span class="sovn-sep" aria-hidden="true">/</span>}
          {i === crumbs.length - 1
            ? <span class="sovn-current">{c.name}</span>
            : <a href={c.url}>{c.name}</a>}
        </>
      ))}
    </nav>
    <BreadcrumbSchema items={crumbs} />

    <!-- Header -->
    <header class="sovn-header">
      <span class="sovn-badge" style={`color: ${kat.color}; background: ${kat.bg};`}>
        {kat.label}
      </span>
      <div class="sovn-meta-row">
        <span class="sovn-meta sovn-byline">
          {bylineLabel} <a href={aboutUrl}>{resolvedAuthor.name}</a>
        </span>
        <span class="sovn-meta">{leseminutter} {labels.lesetid}</span>
        <span class="sovn-meta">
          {labels.oppdatert} <time datetime={oppdatertDato.toISOString().slice(0, 10)}>{oppdatertFmt}</time>
        </span>
      </div>
      <h1 class="sovn-title">{tittel}</h1>
      <p class="sovn-intro">{kortbeskrivelse}</p>
      <ShareButtons url={canonical} title={tittel} variant="inline" lang={lang} />
    </header>

    {bilde && (
      <div class="sovn-image-wrapper">
        <img src={bilde} alt={tittel} class="sovn-image" loading="eager" />
        {bildeFilnavn && <BildeKreditt filnavn={bildeFilnavn} />}
      </div>
    )}

    <!-- 2-column: TOC sidebar + content -->
    <div class="sovn-layout">
      <ContentTOC variant="sticky" lang={lang} contentId="sovn-content" minHeadings={4} accentColor="#1D9E75" />

      <div class="sovn-content prose" id="sovn-content">
        <ContentTOC variant="accordion" lang={lang} contentId="sovn-content" minHeadings={4} accentColor="#1D9E75" />
        <slot />

        <HelpfulnessVote slug={slug} lang={lang} />

        <aside class="sovn-disclaimer" role="note" aria-label={disclaimerLabel}>
          <span class="sovn-disclaimer-label">{disclaimerLabel}</span>
          <p>{disclaimer}</p>
        </aside>

        <AdSlot format="bottom" lang={lang} />

        <!-- Related sovn articles -->
        {relaterteSovnArtikler.length > 0 && (
          <div class="sovn-related">
            <span class="sovn-related-label">{labels.relatert}</span>
            <h3 class="sovn-related-title">{labels.lesMer}</h3>
            <div class="sovn-related-grid">
              {relaterteSovnArtikler.map((art: any) => {
                const artKat = kategoriMap[art.data.kategori] || kategoriMap.vitenskap;
                return (
                  <a href={pathFor(lang, 'sovn', art.data.slug)} class="sovn-related-card">
                    <span class="sovn-related-badge" style={`color: ${artKat.color};`}>{artKat.label}</span>
                    <span class="sovn-related-name">{art.data.tittel}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- Related dream symbols (RelaterteDrommer) -->
        <RelaterteDrommer artikler={relaterteDrommerArtikler} lang={lang} />

        <!-- Related guide articles -->
        {relaterteGuiderArtikler.length > 0 && (
          <div class="sovn-related sovn-related-drommer">
            <span class="sovn-related-label">{labels.fraGuiden}</span>
            <h3 class="sovn-related-title">{labels.drommerOgSovn}</h3>
            <div class="sovn-related-grid">
              {relaterteGuiderArtikler.map((art: any) => (
                <a href={pathFor(lang, 'guider', art.data.slug)} class="sovn-related-card">
                  <span class="sovn-related-badge" style="color: var(--color-accent);">{labels.guideLabel}</span>
                  <span class="sovn-related-name">{art.data.tittel}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <Kommentarer />
      </div>

      <AdSlot format="sidebar" lang={lang} />
    </div>
  </article>

  <!-- Article schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: tittel,
      description: kortbeskrivelse,
      datePublished: dato.toISOString(),
      dateModified: (oppdatert ?? dato).toISOString(),
      inLanguage: langConfig.htmlLang,
      url: canonical,
      ...(bilde && { image: `${baseSite}${bilde}` }),
      author: {
        '@type': resolvedAuthor.type,
        name: resolvedAuthor.name,
        url: `${baseSite}${resolvedAuthor.url}`,
        ...(resolvedAuthor.sameAs.length > 0 && { sameAs: resolvedAuthor.sameAs }),
      },
      publisher: {
        '@type': 'Organization',
        name: langConfig.brand,
        url: baseSite,
      },
    })}
  />

</Base>

<style>
  .sovn-article {
    max-width: 960px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .sovn-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-family: var(--font-nav);
    margin-bottom: 32px;
    padding-top: 8px;
  }
  .sovn-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .sovn-breadcrumb a:hover {
    color: #1D9E75;
    text-decoration: none;
  }
  .sovn-sep { color: var(--color-text-muted); opacity: 0.35; font-size: 11px; }
  .sovn-current { color: var(--color-text-body); }

  /* Header */
  .sovn-header {
    margin-bottom: 36px;
  }
  .sovn-badge {
    display: inline-block;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: var(--border-radius-pill);
    margin-bottom: 16px;
  }
  .sovn-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 14px;
  }
  .sovn-meta {
    font-family: var(--font-nav);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.3px;
  }
  .sovn-byline a {
    color: var(--color-text-body);
    text-decoration: underline;
    text-decoration-color: rgba(45, 41, 38, 0.2);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }
  .sovn-byline a:hover {
    text-decoration-color: #1D9E75;
  }
  .sovn-title {
    font-family: var(--font-heading);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-text-heading);
    margin-bottom: 16px;
    font-weight: 400;
    word-wrap: break-word;
    hyphens: auto;
  }
  @media (min-width: 480px) {
    .sovn-title { font-size: 40px; }
  }
  @media (min-width: 768px) {
    .sovn-title { font-size: 48px; }
  }
  .sovn-intro {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 600px;
  }

  /* Image */
  .sovn-image-wrapper {
    margin-bottom: 40px;
  }
  .sovn-image {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 16px;
  }

  /* 2-column layout (3-col med annonse-sidebar på ≥1100px) */
  .sovn-layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .sovn-layout {
      flex-direction: row;
      gap: 48px;
    }
  }
  @media (min-width: 1100px) {
    .sovn-article {
      max-width: 1280px;
    }
  }

  .sovn-content {
    flex: 1;
    min-width: 0;
  }

  /* Green prose overrides for søvn articles */
  .sovn-content :global(h2) {
    border-left-color: #1D9E75;
  }
  .sovn-content :global(a) {
    color: #1D9E75;
    text-decoration-color: rgba(29, 158, 117, 0.3);
  }
  .sovn-content :global(a:hover) {
    text-decoration-color: #1D9E75;
  }

  /* Disclaimer (informasjonsboks) */
  .sovn-disclaimer {
    margin: 40px 0 0;
    padding: 16px 20px;
    background: rgba(29, 158, 117, 0.06);
    border-left: 3px solid #1D9E75;
    border-radius: 8px;
  }
  .sovn-disclaimer-label {
    display: inline-block;
    font-family: var(--font-nav);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #1D9E75;
    margin-bottom: 6px;
  }
  .sovn-disclaimer p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-body);
  }

  /* Related boxes */
  .sovn-related {
    margin-top: 56px;
    padding: 20px;
    background: rgba(29, 158, 117, 0.04);
    border: 1px solid rgba(29, 158, 117, 0.1);
    border-radius: 16px;
  }
  @media (min-width: 480px) {
    .sovn-related { padding: 28px; }
  }
  .sovn-related-drommer {
    background: rgba(123, 111, 160, 0.04);
    border-color: rgba(123, 111, 160, 0.1);
  }

  .sovn-related-label {
    display: block;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  .sovn-related-title {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--color-text-heading);
    margin-bottom: 18px;
    font-weight: 400;
    border: none;
    padding: 0;
  }
  .sovn-related-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sovn-related-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .sovn-related-card:hover {
    background: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
  .sovn-related-badge {
    font-family: var(--font-nav);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .sovn-related-name {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-heading);
  }
</style>
